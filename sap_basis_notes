## 17.2 Operating System Preparation (Linux — RHEL/SLES)

```bash
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
1. HOSTNAME AND NETWORK CONFIGURATION:
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Set fully qualified hostname
hostnamectl set-hostname sapserver.company.com

# Edit /etc/hosts — CRITICAL for SAP!
vi /etc/hosts
# Add entry:
192.168.1.100   sapserver.company.com   sapserver

# Verify hostname resolution
hostname          # Should return: sapserver
hostname -f       # Should return: sapserver.company.com
ping sapserver.company.com   # Must resolve!

# ⚠️ SAP uses hostname in:
#    - License keys
#    - Profile files
#    - SSL certificates
#    - Transport directory references
#    Changing hostname after installation BREAKS things!

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
2. OS USER AND GROUP CREATION:
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Create SAP OS Groups
groupadd sapsys  -g 79      # SAP system group (all SAP users)
groupadd dba     -g 80      # Database admin group
groupadd oper    -g 81      # Operator group

# Create SAP Administrator User: <sid>adm (lowercase!)
# Example for SID = DEV:
useradd devadm \
  -u 1000 \
  -g sapsys \
  -G dba,oper \
  -d /usr/sap/DEV \
  -s /bin/csh \
  -c "SAP DEV System Administrator"

# Set password for devadm
passwd devadm

# Create Oracle DB User (if using Oracle DB):
useradd oradev \
  -u 1001 \
  -g dba \
  -G oper,sapsys \
  -d /oracle/DEV \
  -s /bin/bash \
  -c "Oracle DEV Database Administrator"

# Verify users created correctly
id devadm
# Output: uid=1000(devadm) gid=79(sapsys) groups=79(sapsys),80(dba),81(oper)

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
3. KERNEL PARAMETERS (/etc/sysctl.conf):
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
vi /etc/sysctl.conf
# Add or modify:

# --- Semaphores (REQUIRED for SAP shared memory) ---
kernel.sem = 1250 256000 100 8192
# Format: SEMMSL SEMMNS SEMOPM SEMMNI

# --- Shared Memory ---
kernel.shmmax = 21474836480      # Max shared mem segment (20 GB)
kernel.shmall = 1310720          # Total shared mem pages
kernel.shmmni = 4096             # Max number of shared mem segments

# --- File System ---
fs.file-max    = 20000000        # Max open file handles
fs.aio-max-nr  = 18446744073709551615

# --- Network ---
net.ipv4.tcp_keepalive_time  = 300
net.ipv4.ip_local_port_range = 1024 65535
net.core.somaxconn           = 4096
net.ipv4.tcp_syn_retries     = 8

# --- Virtual Memory ---
vm.max_map_count   = 2000000
vm.swappiness      = 10           # Reduce swap usage (SAP prefers RAM)

# Apply without reboot:
sysctl -p

# Verify:
sysctl kernel.sem
# Output: kernel.sem = 1250 256000 100 8192

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
4. USER LIMITS (/etc/security/limits.conf):
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
vi /etc/security/limits.conf
# Add at end of file:

# SAP admin user limits
devadm    soft    nofile      65536
devadm    hard    nofile      65536
devadm    soft    nproc       16384
devadm    hard    nproc       16384

# Oracle user limits (if Oracle DB)
oradev    soft    nofile      65536
oradev    hard    nofile      65536
oradev    soft    nproc       16384
oradev    hard    nproc       16384

# Apply limits for PAM (add to /etc/pam.d/login if needed):
# session required pam_limits.so

# Verify after login as devadm:
ulimit -n    # Should show 65536
ulimit -u    # Should show 16384

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
5. SWAP SPACE CONFIGURATION:
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# SAP recommends: swap = 2x RAM (minimum 20 GB)
# Check current swap:
swapon --show
free -h

# Create additional swap file if needed:
dd if=/dev/zero of=/swapfile bs=1G count=20
chmod 600 /swapfile
mkswap /swapfile
swapon /swapfile

# Make permanent (/etc/fstab):
echo "/swapfile none swap sw 0 0" >> /etc/fstab

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
6. FILESYSTEM PREPARATION:
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Required filesystems for SAP:

Filesystem          Min Size    Purpose
─────────────────── ─────────   ────────────────────────────────
/                   20 GB       OS root
/usr/sap            100 GB      SAP installation directory
/sapmnt             50 GB       SAP mount point (shared)
/usr/sap/trans      50 GB       Transport directory
/oracle (or /hana)  500 GB+     Database files

# Create directories:
mkdir -p /usr/sap
mkdir -p /sapmnt
mkdir -p /usr/sap/trans
mkdir -p /usr/sap/trans/{data,cofiles,log,tmp,buffer,bin,EPS/in}

# Set ownership:
chown devadm:sapsys /usr/sap
chown devadm:sapsys /sapmnt
chown devadm:sapsys /usr/sap/trans

# Set permissions:
chmod 755 /usr/sap
chmod 755 /sapmnt
chmod 777 /usr/sap/trans    # All SAP systems need write access!

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
7. DISABLE TRANSPARENT HUGE PAGES (THP):
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# THP causes performance issues with SAP!
# MUST be disabled before installation!

# Immediate (not persistent):
echo never > /sys/kernel/mm/transparent_hugepage/enabled
echo never > /sys/kernel/mm/transparent_hugepage/defrag

# Verify:
cat /sys/kernel/mm/transparent_hugepage/enabled
# Expected: always madvise [never]

# Persistent across reboots — add to /etc/rc.local:
echo 'echo never > /sys/kernel/mm/transparent_hugepage/enabled' >> /etc/rc.local
echo 'echo never > /sys/kernel/mm/transparent_hugepage/defrag' >> /etc/rc.local
chmod +x /etc/rc.local

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
8. REQUIRED OS PACKAGES (RHEL/CentOS):
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
yum install -y \
  uuidd \           # UUID daemon (required!)
  libstdc++ \
  libstdc++-devel \
  glibc \
  glibc-devel \
  libaio \
  libaio-devel \
  nfs-utils \       # For NFS transport directory mount
  tcsh \            # SAP admin user shell
  bind-utils \      # nslookup, dig (for hostname verification)
  net-tools \       # netstat
  lsof              # Check open files/ports

# Enable and start uuidd (CRITICAL for SAP):
systemctl enable uuidd
systemctl start uuidd

# Verify uuidd is running:
systemctl status uuidd
# Must be: active (running)
```

