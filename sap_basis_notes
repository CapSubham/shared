## 17.3 NFS Setup for Transport Directory

```bash
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
SCENARIO: DEV, QAS, PRD servers all need access
          to shared transport directory /usr/sap/trans
          NFS Server: storage-server.company.com
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

ON NFS SERVER (storage-server):
# Install NFS server
yum install -y nfs-utils

# Export /usr/sap/trans to all SAP servers
vi /etc/exports
# Add:
/usr/sap/trans  devserver(rw,sync,no_root_squash)
/usr/sap/trans  qasserver(rw,sync,no_root_squash)
/usr/sap/trans  prdserver(rw,sync,no_root_squash)

# Apply export and start NFS
exportfs -ra
systemctl enable nfs-server
systemctl start nfs-server

# Verify exports:
exportfs -v

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
ON EACH SAP SERVER (DEV, QAS, PRD):
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Mount the shared transport directory
mkdir -p /usr/sap/trans

# Temporary mount test:
mount -t nfs storage-server:/usr/sap/trans /usr/sap/trans

# Verify mount:
df -h | grep trans
ls -la /usr/sap/trans/

# Permanent mount (/etc/fstab):
echo "storage-server:/usr/sap/trans /usr/sap/trans nfs \
  rw,soft,timeo=180,intr,bg 0 0" >> /etc/fstab

# ⚠️ NFS mount options explained:
#   rw      = Read-write
#   soft    = Return error if server unavailable (better than hard)
#   timeo   = Timeout in tenths of a second (180 = 18 seconds)
#   intr    = Allow interrupt signals
#   bg      = Retry in background if first mount fails
```

